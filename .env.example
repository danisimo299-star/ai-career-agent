# --- Database ---------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/ai_career_agent"

# --- Auth (NextAuth / Auth.js) -----------------------------------------
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- AI provider abstraction --------------------------------------------
# One of: mock | openai | anthropic | ollama | groq
# "mock" needs no key and is the default for local development. Used as the
# fallback for AI_CHAT_PROVIDER/AI_GENERATION_PROVIDER below when either is unset.
AI_PROVIDER="mock"
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
# Local Ollama server — no API key needed, but the model must already be
# pulled (`ollama pull <model>`) and the server running (`ollama serve`).
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL=""
# Hosted, fast inference (console.groq.com) — used for heavy structured
# generation (Career Analysis, Roadmap, Resume, ...) while Chat stays on
# Ollama. See src/lib/ai/providers/groq.provider.ts.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Which concrete provider (mock|openai|anthropic|ollama|groq) handles live
# conversational calls (Chat) vs. discrete "Generate ..." product features.
# Each falls back to AI_PROVIDER above when unset.
AI_CHAT_PROVIDER=ollama
AI_GENERATION_PROVIDER=groq

# --- Jobs provider abstraction -------------------------------------------
# One of: mock | hh
JOBS_PROVIDER="mock"
# Optional: an HH.ru OAuth access token from a registered app (dev.hh.ru).
# Without it, JOBS_PROVIDER=hh returns no live vacancies and the app falls
# back to real, correctly-parameterized HH.ru search links instead — it
# never fabricates vacancy data. See ARCHITECTURE.md's "Job Matching"
# section for what HH.ru's public API currently requires.
HH_ACCESS_TOKEN=""
